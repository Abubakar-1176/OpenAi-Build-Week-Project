# ---- Database ----
# Must point at the SAME database you inspect in pgAdmin.
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://servio:servio_dev_pw@localhost:5432/servio_db

# ---- Auth ----
# Generate a strong value for production, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- OpenRouter (AI Assistant) ----
# Create a key at https://openrouter.ai/keys and paste it below.
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models (OpenAI-compatible).
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Servio
